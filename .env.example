# Express API
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restro_management
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# HTTPS (leave empty for local HTTP development)
HTTPS=true
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost.pem

# Vite dev server
VITE_HTTPS=false
VITE_SSL_KEY_PATH=./certs/localhost-key.pem
VITE_SSL_CERT_PATH=./certs/localhost.pem
