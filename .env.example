# Express API
PORT=4000
HOST=127.0.0.1

# Public application address used for payment-provider callbacks.
APP_URL=https://restro.bindasstech.com

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restro_management
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# HTTPS is terminated by Nginx in production. Keep this false unless Node
# directly owns your certificate files.
HTTPS=false
SSL_KEY_PATH=
SSL_CERT_PATH=

# Vite dev server
VITE_HTTPS=false
VITE_SSL_KEY_PATH=./certs/localhost-key.pem
VITE_SSL_CERT_PATH=./certs/localhost.pem
